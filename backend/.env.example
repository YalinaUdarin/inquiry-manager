# Copy this file to .env and adjust if needed.

# Dev and test databases (matching docker-compose.yml defaults)
DATABASE_URL=postgres://inquiry:inquiry@localhost:5432/inquiries
TEST_DATABASE_URL=postgres://inquiry:inquiry@localhost:5432/inquiries_test

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express API listens on
PORT=4000
